{
  "name": "ocr-interface-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve:static": "node scripts/static-server.cjs",
    "build:interface-classification": "node scripts/build-interface-classification.mjs",
    "sync:ocr-docs": "node scripts/sync-ocr-docs.mjs",
    "extract:ocr-source-map": "node scripts/build-ocr-source-map.mjs",
    "validate:ocr-catalog": "node scripts/build-ocr-source-map.mjs --check-catalog",
    "optimize:home-assets": "node scripts/optimize-home-assets.mjs",
    "compat:pc": "npm run build && node scripts/capture-pc-compat.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright": "^1.55.1",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3"
  }
}
